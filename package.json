{
  "name": "search-memory-mcp",
  "mcpName": "io.github.kefyusuf/search-memory-mcp",
  "version": "1.0.0",
  "description": "Free web search and long-term memory for AI assistants via MCP. No API keys; cache, memory and index stay local.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "search-memory-mcp": "build/index.js"
  },
  "files": [
    "build/",
    "migrations/",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "keywords": [
    "mcp",
    "web-search",
    "semantic-search",
    "memory",
    "cross-lingual",
    "sqlite-vec",
    "playwright",
    "transformers.js",
    "model-context-protocol",
    "web-scraping",
    "markdown",
    "claude",
    "claude-desktop",
    "cursor",
    "mcp-server",
    "no-api-key",
    "rag",
    "local-first"
  ],
  "author": "kefyusuf",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kefyusuf/search-memory-mcp.git"
  },
  "homepage": "https://github.com/kefyusuf/search-memory-mcp#readme",
  "bugs": {
    "url": "https://github.com/kefyusuf/search-memory-mcp/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node build/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "test": "vitest run --configLoader native --pool forks",
    "test:watch": "vitest --configLoader native --pool forks",
    "test:coverage": "vitest run --configLoader native --pool forks --coverage",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "test:postgres": "node scripts/verify-membership-postgres.mjs",
    "test:postgres:shutdown": "node scripts/verify-membership-shutdown.mjs",
    "eval:retrieval": "node scripts/eval-retrieval.mjs",
    "benchmark:providers": "node scripts/benchmark-providers.mjs",
    "prepack": "npm run build",
    "postinstall": "playwright install chromium || node -e \"process.exit(0)\"",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.9.0",
    "iconv-lite": "^0.6.3",
    "jose": "6.2.3",
    "jsdom": "^24.0.0",
    "lru-cache": "^10.4.3",
    "pg": "8.23.1",
    "playwright": "^1.42.1",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.1.3",
    "zod": "^3.22.4"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.11.24",
    "@types/pg": "8.23.1",
    "@types/turndown": "^5.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.6"
  }
}
