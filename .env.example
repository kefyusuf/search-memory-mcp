# Rate limiting
RATE_LIMIT_SEARCH_PER_MIN=10
RATE_LIMIT_FETCH_PER_MIN=20

# Search configuration. Values are comma-separated and tried in order.
SEARCH_PROVIDERS=duckduckgo,bing

# Optional official search APIs. Add their provider names to SEARCH_PROVIDERS to use them.
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# EXA_API_KEY=

# Fetch configuration. Supported values: networkidle, domcontentloaded.
FETCH_WAIT_UNTIL=domcontentloaded

# Set to true to skip HTTP-first fetch and always use Playwright.
# FORCE_PLAYWRIGHT=true

# Optional local-model features. Set to true to enable language detection and cross-lingual search support.
ENABLE_CROSSLINGUAL=false

# Cache database path. Relative paths are resolved from the server working directory.
CACHE_DB_PATH=websearch_cache.db

# Expired content cache cleanup interval, in hours.
# CACHE_CLEANUP_INTERVAL_HOURS=24
